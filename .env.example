# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PUBLIC REPOSITORY SAFE)
# ==============================================================================
# Catatan: File ini aman untuk repositori publik karena hanya berisi contoh/placeholder.
# Jangan pernah memasukkan password atau secret asli Anda ke dalam file ini!

# 1. Konfigurasi Server (Self-Hosting / VPS / Docker)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 2. Kredensial Administrator & Keamanan Sesi (Server-Only)
# PERINGATAN: Jangan gunakan awalan VITE_ untuk password/secret agar tidak bocor ke browser!
ADMIN_EMAIL=ini@gmail.com
ADMIN_PASSWORD=GantiDenganPasswordRahasiaAndaMin12Karakter!
SESSION_SECRET=ganti_dengan_minimal_32_karakter_acak_rahasia_untuk_enkripsi_sesi

# 3. Konfigurasi Supabase Database
# Dapatkan Project URL dan Anon Key dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
